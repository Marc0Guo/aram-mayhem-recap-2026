{
  "name": "aram-mayhem-wrapped",
  "version": "1.0.0",
  "private": true,
  "description": "Personal local ARAM Mayhem Wrapped dashboard for Windows.",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "demo": "node scripts/web.mjs demo",
    "dev": "node scripts/web.mjs",
    "predemo": "node -e \"require('better-sqlite3')(':memory:').close()\"",
    "predev": "node -e \"require('better-sqlite3')(':memory:').close()\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "assets:verify": "node scripts/assets-verify.mjs",
    "build": "electron-vite build",
    "dist:win": "electron-vite build && node scripts/with-pnpm.mjs electron-builder --win --x64",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "smoke:native": "electron scripts/native-smoke.cjs",
    "start": "node scripts/web.mjs",
    "release:source": "node scripts/source-release.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller"
    ],
    "ignoredBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "echarts": "6.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "html-to-image": "1.11.13"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Marc0Guo/aram-mayhem-recap-2026.git"
  },
  "homepage": "https://github.com/Marc0Guo/aram-mayhem-recap-2026",
  "bugs": {
    "url": "https://github.com/Marc0Guo/aram-mayhem-recap-2026/issues"
  }
}
